<?xml version="1.0" encoding="utf-8"?><!--
   全量备份规则（Android 12 以下使用 fullBackupContent）。

   会话令牌（SharedPreferences: moonbazaar_session）必须排除：
   它是账号凭据，一旦随备份落到云端或另一台设备，就等于把登录态复制出去。
   注意 Keystore 里的加密密钥本身不参与备份，因此密文在别的设备上也解不开，
   但仍不应把凭据写进备份。
   参见 https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="sharedpref" path="moonbazaar_session.xml"/>
</full-backup-content>
