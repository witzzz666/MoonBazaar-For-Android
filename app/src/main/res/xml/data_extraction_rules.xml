<?xml version="1.0" encoding="utf-8"?><!--
   数据提取规则（Android 12 / API 31 起使用）。

   云备份与设备迁移都必须排除会话令牌所在的 SharedPreferences，
   避免账号凭据被复制到云端或新设备。
   参见 https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="moonbazaar_session.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="moonbazaar_session.xml"/>
    </device-transfer>
</data-extraction-rules>
